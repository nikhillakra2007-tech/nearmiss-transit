# --- Database ---
DATABASE_URL=postgresql+psycopg://nearmiss:nearmiss@localhost:5432/nearmiss
# For local demo/tests without Postgres:
# DATABASE_URL=sqlite:///./nearmiss.db

# --- GTFS Realtime ---
GTFS_REALTIME_URL=https://example-agency.gov/gtfs-rt/vehiclepositions.pb
GTFS_API_KEY=
GTFS_STATIC_URL=https://example-agency.gov/gtfs/static.zip
POLL_INTERVAL_SECONDS=30
FEED_TIMEOUT_SECONDS=15

# --- Retention ---
EVENT_RETENTION_DAYS=14
NEAR_MISS_RETENTION_DAYS=180
PATTERN_RETENTION_DAYS=365

# --- Detection thresholds ---
NEAR_MISS_THRESHOLD=600
RECOVERY_THRESHOLD=300
PATTERN_MIN_OCCURRENCES=3
BASELINE_WINDOW_DAYS=30
DEVIATION_SIGMA=3.0

# --- LLM / agent (optional; system works without it) ---
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=mock-investigator-1

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DEMO_MODE=false
